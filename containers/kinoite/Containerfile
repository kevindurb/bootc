FROM ghcr.io/ublue-os/kinoite-main:44

COPY --from=ghcr.io/kevindurb/dev-scripts:latest / /tmp

RUN /tmp/install-dev-base.sh
RUN /tmp/uninstall-firefox.sh

RUN dnf install --assumeyes \
  waydroid \
  plasma-discover-rpm-ostree \
  && dnf clean all

COPY overlay/ /

RUN mkdir -p /boot/efi/EFI \
  && cp -a /usr/lib/efi/shim/*/EFI/. /boot/efi/EFI/ \
  && cp -a /usr/lib/efi/grub2/*/EFI/. /boot/efi/EFI/

RUN bootc container lint
