#!/usr/bin/env bash
# Prepare the single HTPC user.
#
# The Anaconda/bootc installer can create the account without its home
# directory, which makes graphical sessions fail.  Repair that here.  We also
# remove autologin drop-ins written by older image revisions: the HTPC is
# expected to ask for the user's password at the login manager.
set -euo pipefail

user="$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { print $1; exit }')"

if [[ -z "${user}" ]]; then
  exit 0
fi

home="$(getent passwd "${user}" | cut -d: -f6)"
group="$(id -gn "${user}")"
if [[ -n "${home}" && ! -d "${home}" ]]; then
  install -d -m 0700 -o "${user}" -g "${group}" "${home}"
  cp -a /etc/skel/. "${home}/"
  chown -R "${user}:${group}" "${home}"
fi

# Jellyfin Desktop's Flatpak launcher defaults to desktop mode.  Shadow it in
# the user's application directory with TV + fullscreen flags.  The first-boot
# Flatpak installer runs this unit again once the app is installed.
flatpak_desktop=/var/lib/flatpak/exports/share/applications/org.jellyfin.JellyfinDesktop.desktop
user_apps="${home}/.local/share/applications"
if [[ -f "${flatpak_desktop}" ]]; then
  install -d -m 0755 -o "${user}" -g "${group}" "${user_apps}"
  sed 's|org\.jellyfin\.JellyfinDesktop$|org.jellyfin.JellyfinDesktop --fullscreen --tv|' \
    "${flatpak_desktop}" > "${user_apps}/org.jellyfin.JellyfinDesktop.desktop"
  chown "${user}:${group}" "${user_apps}/org.jellyfin.JellyfinDesktop.desktop"
  chmod 0644 "${user_apps}/org.jellyfin.JellyfinDesktop.desktop"
fi

rm -f /etc/sddm.conf.d/20-htpc-autologin.conf /etc/plasmalogin.conf.d/20-htpc-autologin.conf
