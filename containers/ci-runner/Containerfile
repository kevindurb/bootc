FROM quay.io/fedora/fedora-bootc:44@sha256:830ad08e1579ff8a23ea4a41298aa9ab2fc195373fcb68ca85f5d2553e26b74d

# Base tooling for CI jobs: podman/buildah for image builds, git/git-lfs for
# checkouts, make/jq for common workflow steps. cloud-init consumes the
# KubeVirt cloudInitNoCloud data (runner config + registration on first boot).
RUN dnf install --assumeyes \
      podman \
      buildah \
      podman-docker \
      skopeo \
      tailscale \
      git \
      git-lfs \
      make \
      jq \
      curl \
      nodejs \
      cloud-init \
    && dnf clean all

# forgejo-runner, pinned and checksum-verified. Bump both values together.
ARG FORGEJO_RUNNER_VERSION=13.2.2
ARG FORGEJO_RUNNER_SHA256=6b077ccadc22036ba049cea39b09cfbdc5e5ad6000a38f90c83a19e4fb815543
RUN curl -fsSL -o /usr/local/bin/forgejo-runner \
      "https://code.forgejo.org/forgejo/runner/releases/download/v${FORGEJO_RUNNER_VERSION}/forgejo-runner-${FORGEJO_RUNNER_VERSION}-linux-amd64" \
    && echo "${FORGEJO_RUNNER_SHA256}  /usr/local/bin/forgejo-runner" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/forgejo-runner

# Unprivileged user the runner (and all job steps) run as. Fixed uid so
# XDG_RUNTIME_DIR is deterministic in the systemd unit. /etc/subuid|subgid
# give rootless podman a 65536-id range; linger creates /run/user/<uid> at
# boot so the system service gets a user-runtime directory without a login.
# The bootc base ships newuidmap/newgidmap mode 0755 with an effective
# cap_setuid/cap_setgid file capability. Effective file caps do not work in
# this VM (verified empirically), and the setuid+fcap combo makes the kernel
# grant NEITHER ("not raising all capabilities"), so strip the fcaps and
# setuid them instead.
RUN useradd --uid 1000 --create-home --home-dir /var/lib/forgejo-runner --shell /bin/bash runner \
 && printf 'runner:165536:65536\n' > /etc/subuid \
 && printf 'runner:165536:65536\n' > /etc/subgid \
 && chmod 4755 /usr/bin/newuidmap /usr/bin/newgidmap \
 && setcap -r /usr/bin/newuidmap /usr/bin/newgidmap \
 && mkdir -p /var/lib/systemd/linger \
 && touch /var/lib/systemd/linger/runner \
 && chown -R runner:runner /var/lib/forgejo-runner

# /etc/forgejo-runner holds the runner config (written by cloud-init).
RUN mkdir -p /etc/forgejo-runner

COPY overlay/ /

# Enable the runner + the hourly podman prune timer. The runner unit only
# starts once /var/lib/forgejo-runner/.runner exists (written by first-boot
# registration), so enabling it now is safe.
RUN systemctl enable forgejo-runner.service podman-gc.timer tailscaled.service tailscale-up.service \
    && systemctl enable cloud-init-local.service cloud-init-network.service cloud-config.service cloud-final.service

RUN bootc container lint
