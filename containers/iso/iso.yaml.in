# The live squashfs is labeled container_ro_file_t, so Anaconda has to run with
# SELinux off.  Note that Anaconda copies this kernel argument to the installed
# system; enabling SELinux there needs a relabel first.
label: "bootc-installer"
grub2:
  timeout: 60
  entries:
    - name: "Install @NAME@ (bootc)"
      linux: "/images/pxeboot/vmlinuz inst.stage2=hd:LABEL=bootc-installer console=tty0 inst.graphical selinux=0 rhgb quiet"
      initrd: "/images/pxeboot/initrd.img"
