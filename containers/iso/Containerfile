# Installer environment for bootc-generic-iso.
#
# This image is the *live root* of the ISO, not the image being installed: it
# boots Anaconda, which installs TARGET_IMG from the payload embedded in
# containers-storage.  Any bootc image can be passed as TARGET_IMG; its name is
# also used for the installer's GRUB menu entry.
#
# Based on https://osbuild.org/docs/developer-guide/projects/image-builder/advanced/bootc/isos/
ARG INSTALLER_BASE=quay.io/fedora/fedora-bootc:44
ARG TARGET_IMG
FROM ${INSTALLER_BASE}
ARG TARGET_IMG

# zstd: keep the CLI in sync with libzstd from F44 updates (base ships 1.5.7,
# updates carry 1.6.0); dracut refuses to compress when they mismatch.
RUN dnf5 install --assumeyes \
      anaconda \
      anaconda-install-img-deps \
      anaconda-dracut \
      dracut-config-generic \
      dracut-network \
      dracut-live \
      net-tools \
      grub2-efi-x64-cdboot \
      plymouth \
      podman \
      passwd \
      default-fonts-core-sans \
      default-fonts-other-sans \
      google-noto-sans-cjk-fonts \
      xorriso \
      squashfs-tools \
      isomd5sum \
      zstd \
  && dnf5 clean all

# generic-iso reads shim/grub from /boot/efi, but image-mode Fedora keeps them
# under /usr/lib/efi.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# GRUB menu; the label is also the one Anaconda uses for inst.stage2.  The menu
# entry names the image this ISO installs.
COPY iso.yaml.in /tmp/iso.yaml.in
RUN mkdir -p /usr/lib/image-builder/bootc \
  && name="${TARGET_IMG##*/}" \
  && name="${name%%:*}" \
  && sed "s|@NAME@|${name}|g" /tmp/iso.yaml.in \
       > /usr/lib/image-builder/bootc/iso.yaml \
  && rm -f /tmp/iso.yaml.in

# Put Anaconda in bootc mode: install the payload from the embedded store, and
# record the registry ref as the target so `bootc upgrade` pulls from there.
RUN printf '%s\n' \
      "bootc --source-imgref containers-storage:${TARGET_IMG} --target-imgref ${TARGET_IMG}" \
      > /usr/share/anaconda/interactive-defaults.ks

# Anaconda-in-a-container wiring that lorax normally does.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd \
  && echo "install::14438:0:99999:7:::" >> /etc/shadow \
  && passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
  && if [ -d /usr/share/dnf5/repos.d ]; then \
       mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d; \
     else \
       mv /etc/yum.repos.d /etc/anaconda.repos.d; \
     fi \
  && ln -sf /lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
  && rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -sf /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service
COPY anaconda-shell.conf /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

# The initramfs must carry dracut's anaconda module and dmsquash-live (the
# module that mounts the ISO's squashfs as the live root).
RUN mkdir -p "$(realpath /root)" \
  && KERNEL_VERSION="$(rpm -q --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core)" \
  && DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
       --add "anaconda dmsquash-live" \
       "/usr/lib/modules/${KERNEL_VERSION}/initramfs.img" "${KERNEL_VERSION}"

RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d
COPY allowroot.conf /etc/systemd/user/pipewire.service.d/allowroot.conf
COPY allowroot.conf /etc/systemd/user/pipewire.socket.d/allowroot.conf
